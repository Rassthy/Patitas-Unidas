APP_NAME=PatitasUnidas
APP_ENV=production
APP_KEY=                          # Se genera con: php artisan key:generate
APP_DEBUG=false
APP_URL=http://TU_IP_PUBLICA      # Cambiar por tu IP de EC2 (o dominio si tienes)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=patitas_unidas
DB_USERNAME=patitas_user
DB_PASSWORD=PatitasPass2024!

# Solo para el contenedor MySQL de Docker
DB_ROOT_PASSWORD=RootPass2024!

# Sesiones, cola y caché en base de datos
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Gmail SMTP
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=noreply.patitasunidas@gmail.com
MAIL_PASSWORD="tsso lpvo roee ebqn"
MAIL_FROM_ADDRESS="noreply.patitasunidas@gmail.com"
MAIL_FROM_NAME="PatitasUnidas"

VITE_APP_NAME="${APP_NAME}"

# PayPal Sandbox
PAYPAL_CLIENT_ID=tu_client_id
PAYPAL_SECRET=tu_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
